<% content_for :title, @news_item.title + " - News & Events" %>

<div class="news container">
  <h1><%= @news_item.title %></h1>
  <% if @news_item.header.attached? %>
  <%= @news_item.content %>
  <% else %>
  <%= sanitizemarkdown(Kramdown::Document.new(@news_item.body).to_html) if @news_item.body%>
  <% end %>
</div>

<div class="container">
  <p><%=link_to "View more news & events", news_index_path, class: "btn btn-lil" %></p>
  <br />
</div>
